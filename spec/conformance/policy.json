  "policies": [
    {
      "name": "starter",
      "policy": {
        "version": 1,
        "default": "deny",
        "tools": {
          "lookup_*": {
            "risk": "read"
          },
          "list_*": {
            "risk": "read"
          },
          "get_*": {
            "risk": "read"
          },
          "read_inbox": {
            "risk": "read",
            "taints": true,
            "description": "Returns untrusted e-mail content: taints the session"
          },
          "fetch_url": {
            "risk": "read",
            "taints": true
          },
          "send_email": {
            "risk": "external_comm",
            "redact": [
              "body"
            ]
          },
          "refund": {
            "risk": "financial"
          },
          "delete_*": {
            "risk": "destructive"
          }
        },
        "rules": [
          {
            "id": "reads",
            "description": "Read-only tools are allowed",
            "tool": [
              "lookup_*",
              "list_*",
              "get_*",
              "read_inbox",
              "fetch_url"
            ],
            "effect": "allow"
          },
          {
            "id": "refund-auto",
            "description": "Small refunds are automatic",
            "tool": "refund",
            "when": "args.amount <= 50 && args.currency == 'EUR'",
            "effect": "allow"
          },
          {
            "id": "refund-approval",
            "description": "€50–500 needs a human",
            "tool": "refund",
            "when": "args.amount > 50 && args.amount <= 500 && args.currency == 'EUR'",
            "effect": "require_approval",
            "approval": {
              "approvers": 1,
              "timeout": "15m"
            }
          },
          {
            "id": "refund-limit",
            "tool": "refund",
            "when": "args.amount > 500 || args.currency != 'EUR'",
            "effect": "deny",
            "reason": "Refunds above €500 (or not in EUR) must be done by finance, not by an agent"
          },
          {
            "id": "email-internal",
            "tool": "send_email",
            "when": "args.to.all(r, r.endsWith('@example.com'))",
            "effect": "allow_with_obligations",
            "obligations": [
              {
                "type": "annotate",
                "tags": [
                  "internal-email"
                ]
              }
            ]
          },
          {
            "id": "email-external",
            "tool": "send_email",
            "when": "!args.to.all(r, r.endsWith('@example.com'))",
            "effect": "require_approval",
            "reason": "External recipients need approval"
          },
          {
            "id": "no-exfil-after-untrusted",
            "description": "Lethal trifecta guard: after reading untrusted content, never write to external channels",
            "tool": "send_email",
            "when": "session.tainted && !args.to.all(r, r.endsWith('@example.com'))",
            "effect": "deny",
            "reason": "Session processed untrusted content; external e-mail is blocked (possible prompt injection)"
          },
          {
            "id": "destructive-four-eyes",
            "description": "Deletes need two humans",
            "tool": "delete_*",
            "effect": "require_approval",
            "approval": {
              "approvers": 2,
              "timeout": "30m"
            }
          },
          {
            "id": "no-prod-delete-at-night",
            "tool": "delete_*",
            "when": "has(args.environment) && args.environment == 'production' && (env.hour_utc < 6 || env.hour_utc >= 22)",
            "effect": "deny",
            "reason": "No destructive production changes outside working hours"
          }
        ]
      },
